{
  "name": "synapse-tui",
  "version": "0.1.0",
  "private": true,
  "description": "Modern React-based terminal UI for Synapse Editor",
  "type": "module",
  "bin": {
    "synapse-tui": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --out-dir dist --clean",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "meow": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
